<IfModule mod_headers.c>
    # Allow cross-origin requests from ganatube.in and betatesting.ganatube.in (always set ensures CORS even on 4xx/5xx errors)
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-ManageGT-Token"
    Header always set Access-Control-Max-Age "86400"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^fea-req/?$ fea-req.php [L,QSA]
</IfModule>

# ── Performance: Browser Caching ──────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    # Cache static JSON files for 10 minutes
    ExpiresByType application/json "access plus 10 minutes"
    # Cache images for 1 day
    ExpiresByType image/jpeg "access plus 1 day"
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/webp "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
    # Set no-cache for PHP responses unless PHP script explicitly sets its own Cache-Control
    <FilesMatch "\.php$">
        Header setifempty Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
